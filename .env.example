# Infected Voices studio plan placeholders. Cap uses the store IDs only.
# Stripe price values are placeholders until live prices exist.
IV_IAP_BASIC_IOS=space.infectedvoices.studio.basic.monthly
IV_IAP_PRO_IOS=space.infectedvoices.studio.pro.monthly
IV_IAP_BASIC_ANDROID=iv_studio_basic
IV_IAP_PRO_ANDROID=iv_studio_pro
IV_STRIPE_PRICE_BASIC=price_basic_placeholder
IV_STRIPE_PRICE_PRO=price_pro_placeholder
# Checkout sends trial_period_days when the Stripe prices exist. Until then the app uses trialEndsAt.
IV_STRIPE_TRIAL_DAYS=7
